entrypoint = "main.py"
modules = ["python-3.8:v2-20230907-3d66d15"]

hidden = [".pythonlibs"]

[nix]
channel = "stable-23_05"

[env]
LANG = "en_US.UTF-8"

[deployment]
run = ["sh", "-c", "/nix/store/qzc04a3npl70cyyy6flnnrb2ig3kayxm-python3-3.13.11/bin/python3 $file"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 5000
externalPort = 80
