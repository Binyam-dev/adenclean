# AdenClean server settings. This file documents them; the server reads real environment
# variables (set them in Render, never commit real values). Lines with a value show the default.

# --- Required in production -----------------------------------------------------------
# Where data lives: "appwrite" (default) or "memory" (local development; saves nothing and
# is refused on Render).
ADENCLEAN_STORAGE=appwrite
APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
# Runtime key: scopes rows.read and rows.write only. setup_appwrite.py needs a separate,
# temporary key with database, table, column and index scopes.
APPWRITE_API_KEY=
# Signs admin sessions and marketplace sign-in tokens. At least 32 random characters.
# Render generates it (render.yaml). Changing it signs everyone out.
SESSION_SECRET=

# --- Optional ---------------------------------------------------------------------------
APPWRITE_DATABASE_ID=adenclean
# Port to listen on. Render sets this itself.
PORT=5000
# Number of trusted reverse proxies in front of the server (1 on Render), so rate limits
# and logs use the visitor's address instead of the proxy's.
ADENCLEAN_PROXY_HOPS=0
# Error monitoring. Leave empty to turn it off. When set, unhandled server errors are sent
# to Sentry without request bodies, cookies or customer details.
SENTRY_DSN=
# Name shown in health output and error reports, for example the git commit. Render sets
# RENDER_GIT_COMMIT automatically and the server uses it when this is empty.
ADENCLEAN_RELEASE=
# Push notifications about request status (version 1.0.1 of the app). Off unless set to 1.
# Needs the push_tokens column: run setup_appwrite.py BEFORE turning this on.
PUSH_ENABLED=
# Only if "enhanced security" is switched on for the project in Expo.
EXPO_ACCESS_TOKEN=
# Path to a CA bundle, for a network that inspects HTTPS (never disable certificate checks).
PUSH_CA_BUNDLE=
# Local development only: lets the Expo web preview on another port call the API.
# Must start with http://localhost: and must never be set in production.
ADENCLEAN_DEV_CORS_ORIGIN=

# --- Marketplace (switched off for version 1; leave unset) ------------------------------
# MARKETPLACE_ENABLED=1 turns on /api/v1. It needs the marketplace tables (run
# setup_appwrite.py) and the settings below.
MARKETPLACE_ENABLED=
PAYMENTS_ENABLED=
VETTING_REQUIRED=1
PUBLIC_BASE_URL=https://adenclean.onrender.com
SERVICE_ZIPS=
# Sign-in codes and staff alerts: MAIL_MODE is off, dev or resend.
MAIL_MODE=off
MAIL_FROM=
RESEND_API_KEY=
ALERT_EMAIL=applications@adeneats.com
# Stripe (test keys unless STRIPE_LIVE_OK=1) and Checkr (sandbox unless CHECKR_LIVE_OK=1).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_OK=
CHECKR_API_KEY=
CHECKR_PACKAGE=
CHECKR_WEBHOOK_KEY=
CHECKR_LIVE_OK=
